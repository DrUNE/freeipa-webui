{
  "name": "freeipa-webui",
  "version": "0.2.1",
  "homepage": ".",
  "private": true,
  "author": "",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@patternfly/patternfly": "^6.6.1",
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@patternfly/react-topology": "^6.6.0",
    "@reduxjs/toolkit": "^2.13.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "tiny-invariant": "^1.3.3"
  },
  "scripts": {
    "dev": "npm run dev:prepare && vite",
    "dev:prepare": "rm -rf dist && mkdir dist && cp index.dev.html dist/index.html && cp public/favicon.ico dist/favicon.ico",
    "build": "tsc -b && vite build",
    "audit-ci": "audit-ci --config audit-ci.json",
    "cypress": "cypress run",
    "cypress:open": "cypress open",
    "lint": "eslint --color --max-warnings 820",
    "lint:fix": "eslint --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "cache:verify": "npm cache verify",
    "cache:clean": "npm cache clean --force",
    "knip": "knip",
    "i18n:generate": "node scripts/generate-i18n-types.ts"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint-react/eslint-plugin": "^5.26.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.4",
    "audit-ci": "^7.1.0",
    "cy-verify-downloads": "^0.3.0",
    "cypress": "^15.21.1",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "otpauth": "^9.5.2",
    "prettier": "^3.9.10",
    "rollup-plugin-license": "^3.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/common/**/*.ts",
      "cypress/e2e/[filepart]/*.ts"
    ]
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "cypress@15.21.1": true,
    "esbuild": true,
    "fsevents@2.3.3": true,
    "oxc-resolver@11.24.2": true
  }
}
