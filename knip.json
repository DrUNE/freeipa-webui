{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx!",
    "cypress/e2e/**/*.ts",
    "!cypress/e2e/common/**/*.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "src/**/*.tsx!",
    "cypress/e2e/**/*.ts",
    "!cypress/e2e/common/**/*.ts"
  ],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["podman"],
  "rules": {
    "files": "error",
    "dependencies": "off",
    "unlisted": "off",
    "binaries": "error",
    "unresolved": "off",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  },
  "ignore": [
    "src/utils/*.ts",
    "src/utils/*.tsx",
    "src/utils/**/*.ts",
    "src/utils/**/*.tsx",
    "src/hooks/useTranslation.ts",
    "src/services/rpci18n.ts",
    "src/services/rpc.ts",
    "src/services/gpoCommands.ts",
    "src/services/rpcGpo.ts",
    "src/services/rpcChain.ts",
    "src/services/rpcGpmaster.ts",
    "src/services/rpcGpoEditor.ts",
    "src/hooks/useGpoPluginAvailable.ts",
    "src/components/Form/CategoryToggleSection/CategoryToggleSection.tsx",
    "src/components/Form/CategoryToggleSection/index.ts",
    "src/components/Form/CheckboxListWithFilter/CheckboxListWithFilter.tsx",
    "src/components/Form/CheckboxListWithFilter/index.ts",
    "src/components/Form/IpaCheckboxListWithFilter/IpaCheckboxListWithFilter.tsx",
    "src/components/Form/IpaCheckboxListWithFilter/index.ts"
  ]
}
